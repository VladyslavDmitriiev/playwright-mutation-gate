{
  "name": "playwright-mutation-gate",
  "version": "0.6.0",
  "description": "Mutation testing for Playwright assertions: invert each test's primary assertion and fail the run if the test stays green.",
  "keywords": [
    "playwright",
    "mutation-testing",
    "e2e",
    "testing",
    "test-quality",
    "assertions",
    "hollow-tests",
    "ci",
    "qa"
  ],
  "license": "MIT",
  "author": "Vladyslav Dmitriiev <vladyslav.dmitriiev@pm.me>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "playwright-mutation-gate": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:e2e && npm run test:integration"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladyslavDmitriiev/playwright-mutation-gate.git"
  },
  "homepage": "https://github.com/VladyslavDmitriiev/playwright-mutation-gate#readme",
  "bugs": {
    "url": "https://github.com/VladyslavDmitriiev/playwright-mutation-gate/issues"
  }
}
